# ── Шрифт для PDF-выгрузки аналитики ──────────────────────────────────────
# assets/fonts/DejaVuSans.ttf лежит в репозитории осознанно (см. 9fe6153): архив
# Cloud Function собирается из дерева, а в рантайме функции нет ни apt, ни
# системных шрифтов — без файла в git выгрузка в PDF отдавала 503 после каждого
# чистого деплоя. Обновляется через scripts/fetch_pdf_font.py.
# Недокачанный файл от прерванного прогона скрипта (пишем через <имя>.ttf.part).
assets/fonts/*.part
