# ── База данных ───────────────────────────────────────────────────────────────
# Локально (docker compose): хост db; локальный запуск: localhost.
DATABASE_URL=postgresql+asyncpg://faberge:faberge@localhost:5432/faberge
# Yandex Managed PostgreSQL 17 (TLS обязателен — скачайте CA-сертификат):
#   DATABASE_URL=postgresql+asyncpg://<user>:<pwd>@<fqdn>:6432/<db>
#   DB_SSL_ROOT_CERT=/home/<user>/.postgresql/root.crt
# DB_SSL_ROOT_CERT=
SQL_ECHO=false

# ── Приложение ────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*
# Bearer-токен администратора для /admin/** (его же возвращает POST /admin/login).
ADMIN_API_TOKEN=dev-admin-token
# Учётные данные для POST /admin/login (логин/пароль → access_token = ADMIN_API_TOKEN).
# В проде ОБЯЗАТЕЛЬНО переопределите оба значения.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
MEDIA_DIR=media
# Уровень логирования. INFO обязателен, чтобы в логах функции были видны строки
# расхода (llm_usage / tts_request): рантайм Cloud Functions оставляет корневой
# логгер на WARNING, и приложение поднимает уровень само (app/main.py).
LOG_LEVEL=INFO

# ── Загрузка файлов ───────────────────────────────────────────────────────────
# Лимит размера загружаемого файла (фото для распознавания, фото экспоната,
# обложка зала), МБ. 2.5 — не наша прихоть, а потолок платформы (п.10 баг-репорта
# 06.08.2026): Yandex API Gateway рубит запрос целиком на 3 670 016 байт (3.5 МиБ)
# и отвечает 413 «request entity is larger than limits (3670016)». Лимит меряется
# по ВСЕМУ запросу — multipart-обвязка плюс base64, которым гейтвей передаёт тело
# функции, — поэтому на сам файл остаётся ~2.5 МБ; расчёт в app/config.py.
# Значение больше платформенного приложение всё равно зажмёт и напишет WARNING.
MAX_UPLOAD_MB=2.5
# Потолок API Gateway на весь HTTP-запрос, байты. Нужен только для расчёта лимита
# на файл. Кодом НЕ поднимается: менять его можно исключительно в конфигурации
# API Gateway / квотах Yandex Cloud (у синхронного вызова функции лимит такой же).
# GATEWAY_MAX_REQUEST_BYTES=3670016
# Запас на multipart-обвязку и заголовки внутри лимита гейтвея, байты.
# UPLOAD_REQUEST_OVERHEAD_BYTES=65536
# ВАЖНО про CORS: ответ 413 от самого гейтвея приходит БЕЗ Access-Control-Allow-*,
# поэтому браузер показывает «Failed to fetch» вместо кода ошибки. CORS_ORIGINS
# выше на это не влияет — это заголовки нашего приложения, а такой запрос до него
# не доходит. Лечится только правкой спецификации API Gateway (см. отчёт по п.10).

# ── Распознавание по фото ─────────────────────────────────────────────────────
# Порог уверенности: ниже — экспонат не считается распознанным, но кандидаты
# всё равно возвращаются (фронт показывает «возможно, это»).
RECOGNITION_CONFIDENCE_THRESHOLD=0.6
# Таймаут запроса к ML-сервису поиска по фото, секунды.
RECOGNITION_TIMEOUT_SEC=25
# Порог нечёткой сшивки названия из ML-индекса с названием в каталоге (0..1).
# Ниже порога предсказание отбрасывается и пишется в лог (WARNING) вместе с
# самим title — по этим строкам видно, какие названия разошлись. 0 — только
# точное совпадение (после нормализации регистра/«ё»/кавычек/пробелов).
RECOGNITION_NAME_MATCH_CUTOFF=0.86

# ── Озвучивание ───────────────────────────────────────────────────────────────
# Прогонять произвольный текст через LLM, чтобы числа звучали порядковыми
# («Пётр Первый», а не «Пётр один»). LLM зовётся только если в тексте есть числа,
# результат кэшируется по хэшу текста. false — только детерминированная
# нормализация (дешевле, но грубее в падежах).
TTS_SPOKEN_VIA_LLM=true
# Версия REST API SpeechKit: v3 (по умолчанию) или v1. v1 тарифицируется по
# СИМВОЛАМ, v3 — по ЗАПРОСАМ; у нас запросы короткие, поэтому v3 дешевле.
# Значение v1 — аварийный откат: код обоих путей живёт в app/services/tts.py.
SPEECHKIT_API_VERSION=v3

# ── Расход LLM ────────────────────────────────────────────────────────────────
# Модель для «числа прописью» (llm.to_spoken_text). Задача механическая, Pro на
# ней переплата. Пусто — URI выводится из YANDEXGPT_MODEL_URI заменой
# yandexgpt → yandexgpt-lite; для дообученной модели (ds://…) подстановка не
# срабатывает и запрос идёт на основную модель.
# YANDEXGPT_LITE_MODEL_URI=gpt://<folder-id>/yandexgpt-lite/latest
# Сколько последних реплик диалога уходит в промпт уточняющего вопроса (было 6).
GUIDE_HISTORY_TURNS=3
# Потолок справки об экспонате/зале в промпте диалога, знаков (режется по
# границе фразы). Полное raw_history оплачивается на КАЖДОМ уточняющем вопросе.
GUIDE_GROUNDING_MAX_CHARS=700
# Целевой объём рассказа POST /guide/story, знаков (держится промптом), и
# страховочный потолок ответа в токенах.
GUIDE_STORY_MAX_CHARS=1200
GUIDE_STORY_MAX_TOKENS=500
# Писать в лог расход токенов на каждый вызов LLM. Строки вида
#   llm_usage operation=chat model=gpt://…/yandexgpt/latest input_tokens=412 output_tokens=180 total_tokens=592
# грепаются в логах функции — по ним считается стоимость ответа.
LLM_LOG_USAGE=true

# ── Аналитика посетителей ─────────────────────────────────────────────────────
# Неактивность, после которой визит считается завершённым (требование заказчика).
# Поток событий сессии режется по этому разрыву, даже если session_end не дошёл.
SESSION_TIMEOUT_MINUTES=30
# Отчёты отдаются из кэша агрегатов; запись старше этого срока пересчитывается на
# лету. Реалтайм по ТЗ не требуется — данные обновляет ночной джоб
# (scripts/rebuild_analytics.py) либо POST /admin/analytics/rebuild.
ANALYTICS_CACHE_TTL_MINUTES=1440
# Кластер вопросов с частотой не выше этого числа попадает в «редкие».
ANALYTICS_RARE_MAX_COUNT=2
# Шрифт с кириллицей для PDF-выгрузки отчётов. Пусто — ищем по стандартным путям
# системы (DejaVu в Linux-образах, Arial Unicode в macOS) и в
# assets/fonts/DejaVuSans.ttf. Без шрифта /admin/analytics/export?format=pdf
# вернёт 503, а не лист с квадратами вместо кириллицы.
# ANALYTICS_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# ── Yandex Cloud (опционально; без ключей сервисы работают в режиме-стабе) ─────
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEXGPT_MODEL_URI=gpt://<folder-id>/yandexgpt/latest
# YOLO_ENDPOINT=https://<your-yolo-endpoint>/recognize
# SPEECHKIT_API_KEY=
# Object Storage. Бакет должен быть открыт на чтение НА УРОВНЕ БАКЕТА
# (bucket policy / «публичный доступ на чтение») — отдельный ACL на объект
# бэкенд не выставляет. URL объекта = OBJECT_STORAGE_PUBLIC_BASE/<key>
# (или OBJECT_STORAGE_ENDPOINT/<bucket>/<key>, если CDN-домен не задан).
# OBJECT_STORAGE_BUCKET=faberge-media
# OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# OBJECT_STORAGE_PUBLIC_BASE=https://cdn.example.cloud
# AWS_ACCESS_KEY_ID=          # статический ключ сервисного аккаунта (для Object Storage)
# AWS_SECRET_ACCESS_KEY=
